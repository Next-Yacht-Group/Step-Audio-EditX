FROM nvcr.io/nvidia/vllm:26.04-py3

ENV DEBIAN_FRONTEND=noninteractive \
    HF_HOME=/models/.cache/huggingface \
    TRANSFORMERS_CACHE=/models/.cache/huggingface \
    PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ffmpeg \
    git \
    git-lfs \
    libsndfile1 \
    libsndfile1-dev \
    libsox-dev \
    sox \
    && git lfs install \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.spark.txt /tmp/requirements.spark.txt

# Mantiene NumPy, PyTorch, vLLM e setuptools nelle versioni NVIDIA.
RUN python3 -m pip install --no-cache-dir \
    -r /tmp/requirements.spark.txt

# ONNX Runtime GPU CUDA 13 per Linux ARM64.
RUN python3 -m pip uninstall -y \
    onnxruntime onnxruntime-gpu || true

RUN python3 -m pip install --no-cache-dir \
    coloredlogs flatbuffers packaging protobuf sympy \
 && python3 -m pip install --no-cache-dir --pre --no-deps \
    --index-url https://aiinfra.pkgs.visualstudio.com/PublicPackages/_packaging/ort-cuda-13-nightly/pypi/simple/ \
    onnxruntime-gpu


# TorchAudio installato indirettamente da pip è compilato per CUDA 13.0,
# mentre il PyTorch NVIDIA del container usa CUDA 13.2.
# Lo ricompiliamo contro il PyTorch già installato.
RUN apt-get update && apt-get install -y --no-install-recommends \
    cmake \
    ninja-build \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m pip uninstall -y torchaudio \
    && git clone --depth 1 https://github.com/pytorch/audio.git /opt/torchaudio \
    && cd /opt/torchaudio \
    && PIP_CONSTRAINT=/dev/null \
       USE_CUDA=0 \
       BUILD_SOX=0 \
       USE_FFMPEG=0 \
       BUILD_RNNT=0 \
       BUILD_CTC_DECODER=0 \
       python3 -m pip install \
           --no-cache-dir \
           --no-deps \
           --no-build-isolation \
           -e .

# Il container porta solo lo stub di cuFFT (13 KB, serve al linker), non la
# libreria vera: qualunque FFT su GPU muore con "cuFFT error: unknown error 50".
# Il frontend fbank di funasr ne fa una per ogni wav di riferimento, quindi senza
# questo nessuna clonazione parte. Il pacchetto senza suffisso è quello CUDA 13, e
# 12.2.0.46 è la versione che il container si aspetta (CUFFT_VERSION).
RUN python3 -m pip install --no-cache-dir --no-deps \
    --extra-index-url https://pypi.nvidia.com \
    nvidia-cufft==12.2.0.46 \
 && ln -sf /usr/local/lib/python3.12/dist-packages/nvidia/cu13/lib/libcufft.so.12 \
           /usr/local/cuda/targets/sbsa-linux/lib/libcufft.so.12 \
 && ldconfig \
 && test "$(stat -c%s /usr/local/lib/python3.12/dist-packages/nvidia/cu13/lib/libcufft.so.12)" -gt 100000000

COPY . /app

EXPOSE 7860

CMD ["python3", "app.py", \
     "--model-path", "/models/Step-Audio-EditX", \
     "--tokenizer-path", "/models/Step-Audio-Tokenizer", \
     "--model-source", "local", \
     "--server-name", "0.0.0.0", \
     "--server-port", "7860", \
     "--gpu-memory-utilization", "0.20", \
     "--max-num-seqs", "1", \
     "--enforce-eager", \
     "--cosyvoice-dtype", "float32", \
     "--no-cosyvoice-cuda-graph"]
